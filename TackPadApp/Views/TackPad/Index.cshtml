@model IEnumerable<TackPad>
@{
    ViewData["Title"] = "Index";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">TackPad List</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="TackPad" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> &nbsp; Create New Category
            </a>
        </div>
    </div>


<table class="table table-bordered table-striped" style="width:100%">
    <thead>
        <tr>
            <th>
                Note Id
            </th>
            <th>
                Title
            </th>
            <th>
                Note
            </th>
            <th>
                Status
            </th>
            <th>
                Date to complete
            </th>
            <th>
                Bearbeiten
            </th>
            <th>
                Löschen
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach(var obj in Model)
        {
            <tr>
                <td width="10%">
                    @obj.Id                
                </td>
                <td width="15%">
                    @obj.Title             
                </td>
                <td width="30%">
                    @obj.Note            
                </td>
                <td width="5%">
                    @obj.Status            
                </td>
                <td width="35%">
                    @obj.DateToComplete            
                </td>
                <td width="35%">
                    <div class="w-75 btn-group" role="group">
                        <a asp-controller="TackPad" asp-action="Edit" asp-route-id="@obj.Id" 
                        class="btn btn-primary mx-2"> <i class="bi bi-pencil-square"></i> Edit</a>
                    </div>          
                </td>
                <td width="35%">
                    <div class="w-75 btn-group" role="group">
                        <a asp-controller="TackPad" asp-action="Delete" asp-route-id="@obj.Id" 
                        class="btn btn-primary mx-2"> <i class="bi bi-pencil-square"></i> Delete</a>
                    </div>          
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
